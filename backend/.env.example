DATABASE_URL=
DIRECT_URL=
CORS_ORIGINS=http://localhost:5173
APP_TIMEZONE=Europe/Budapest
DB_POOL_SIZE=3
DB_MAX_OVERFLOW=2
DB_POOL_TIMEOUT=15
DB_POOL_RECYCLE=1800

SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Backend only. Required solely for authenticated account deletion.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only LLM configuration. No frontend AI keys.
AI_PROVIDER=gemini
AI_MODEL=
GEMINI_API_KEY=
AI_TIMEOUT_SECONDS=15

# Optional backend-only signing key (32+ random characters). Required for shared
# import previews across multiple workers; blank uses a process-local random key.
WORKSPACE_IMPORT_SIGNING_KEY=
